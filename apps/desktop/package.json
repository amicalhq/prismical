{
  "name": "@prismical/desktop",
  "version": "0.3.4",
  "license": "MIT",
  "description": "Prismical Desktop app",
  "private": true,
  "main": ".vite/build/entry.js",
  "productName": "Prismical",
  "author": {
    "name": "Prismical",
    "email": "contact@prismical.ai",
    "url": "https://prismical.ai"
  },
  "scripts": {
    "dev": "pnpm build:deps && node scripts/dev.cjs",
    "start": "pnpm build:deps && node scripts/dev.cjs",
    "package": "pnpm build:deps && electron-forge package",
    "make": "pnpm build:deps && electron-forge make",
    "build:deps": "node scripts/build-deps.cjs",
    "build:worker": "tsx scripts/build-whisper-worker.ts",
    "download-node": "tsx scripts/download-node-binaries.ts",
    "download-node:all": "tsx scripts/download-node-binaries.ts --all",
    "fetch-eval-model": "tsx scripts/fetch-eval-model.ts",
    "lint": "eslint .",
    "type:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:local-asr": "pnpm build:worker && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:bundle": "PRISMICAL_E2E_TARGET=bundle playwright test",
    "test:e2e:fresh": "PRISMICAL_E2E_PACKAGE=1 pnpm package && playwright test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@ai-sdk/openai-compatible": "catalog:",
    "@prismical/ai-prompts": "workspace:*",
    "@prismical/api-contracts": "workspace:*",
    "@prismical/editor-markdown": "workspace:*",
    "@prismical/app-client": "workspace:*",
    "@prismical/app-contracts": "workspace:*",
    "@prismical/app-i18n": "workspace:*",
    "@prismical/app-ui": "workspace:*",
    "@prismical/audio-capture": "workspace:*",
    "@prismical/desktop-contracts": "workspace:*",
    "@prismical/eventkit-helper": "workspace:*",
    "@prismical/id": "workspace:*",
    "@prismical/mic-detector": "workspace:*",
    "@prismical/silence": "workspace:*",
    "@prismical/whisper-wrapper": "workspace:*",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.95.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "catalog:",
    "effect": "3.21.2",
    "electron-log": "^5.4.0",
    "electron-squirrel-startup": "^1.0.1",
    "i18next": "catalog:",
    "jose": "^6.1.0",
    "lucide-react": "^0.553.0",
    "posthog-js": "^1.396.6",
    "posthog-node": "5.34.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "split2": "^4.2.0",
    "ai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "catalog:",
    "@prismical/eslint-config": "workspace:*",
    "@prismical/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.1.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "catalog:",
    "tailwindcss": "^4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/split2": "^4.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "bumpp": "10.2.3",
    "dotenv": "^16.5.0",
    "drizzle-kit": "catalog:",
    "electron": "43.1.0",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "^7.1.5",
    "vitest": "catalog:"
  }
}
