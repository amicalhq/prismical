# apps/desktop build/dev inputs. Copy to apps/desktop/.env (gitignored).
# forge.config.ts loads this file (dotenv) before packaging AND before the
# vite defines are computed; vite.main.config.mts itself reads only plain env.

# ── Sign-in (required for a working sign-in; no committed default) ──────────
# The PUBLIC desktop OAuth client id (PKCE, no secret) registered on the core
# deployment you sign in against, with the redirect URIs prismical://oauth/callback
# and http://127.0.0.1:17829/oauth/callback (the dev loopback). Use the public
# client id registered by the Prismical deployment you target. Release CI
# injects it from secrets. Absent ⇒ cloud-mode sign-in reports NOT_CONFIGURED;
# local mode is unaffected.
PRISMICAL_CLIENT_ID=

# ── Telemetry (optional; absent ⇒ telemetry disabled) ───────────────────────
# PostHog ingestion key (shared with the browser client). Baked at build time.
# PRISMICAL_ANALYTICS_KEY=
# Runtime/analytics host overrides (defaults: the committed public endpoints).
# PRISMICAL_ANALYTICS_HOST=https://p.prismical.ai

# ── Endpoint overrides (optional; dev defaults are the portless stack) ──────
# PRISMICAL_CORE_API_URL=https://prismical-core.localhost
# PRISMICAL_NOTE_WS_URL=wss://prismical-note.localhost/collaboration
# PRISMICAL_WEB_APP_ORIGIN=https://prismical-web.localhost
# Packaged-build DEFAULTS (baked): override only when building against another
# deployment.
# PRISMICAL_CORE_API_URL_DEFAULT=https://core.prismical.ai
# PRISMICAL_NOTE_WS_URL_DEFAULT=wss://note.prismical.ai/collaboration
# PRISMICAL_WEB_APP_ORIGIN_DEFAULT=https://app.prismical.ai
# PRISMICAL_ANALYTICS_HOST_DEFAULT=https://p.prismical.ai

# ── macOS signing + notarization (packaging only) ───────────────────────────
# CODESIGNING_IDENTITY="Developer ID Application: Your Company (XXXXXXXXXX)"
# APPLE_ID=your.email@example.com
# APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=XXXXXXXXXX
# Signing is skipped unless SKIP_CODESIGNING=false (see forge.config.ts).
# SKIP_CODESIGNING=false

# Optional release source-map upload. These credentials are build-only.
# POSTHOG_SOURCE_MAP_UPLOAD=true
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_ID=
# POSTHOG_RELEASE_SHA=
# POSTHOG_HOST=https://us.posthog.com

# Local diagnostic controls (runtime environment; credentials/content stay scrubbed).
# Production: file info+, console warn+. Development: debug+ in both.
# LOG_LEVEL=warn overrides both outputs. Allowed: debug, info, warn, error.
# LOG_DEBUG_SCOPES=audio,/whisper/ selects debug scopes; production console stays warn+.
