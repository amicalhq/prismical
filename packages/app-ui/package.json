{
  "name": "@prismical/app-ui",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Shared renderer UI (design tokens, primitives, shell, screens) for the web and desktop renderers. No next/* or electron imports.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ui/*": "./src/ui/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./shell/*": "./src/shell/*.tsx",
    "./screens/*": "./src/screens/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./styles/tokens.css": "./src/styles/tokens.css"
  },
  "scripts": {
    "lint": "eslint src/ --max-warnings 0",
    "type:check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.76",
    "@prismical/app-client": "workspace:*",
    "@prismical/app-contracts": "workspace:*",
    "@prismical/app-i18n": "workspace:*",
    "@prismical/editor-markdown": "workspace:*",
    "@shadcn/react": "^0.2.1",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.101.0",
    "@tiptap/react": "^3.23.4",
    "ai": "catalog:",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "driver.js": "^1.8.0",
    "lucide-react": "^0.553.0",
    "nanoid": "^5.1.11",
    "radix-ui": "^1.5.0",
    "react-i18next": "catalog:",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^2.6.1",
    "tw-animate-css": "^1.4.0",
    "yjs": "^13.6.27"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@prismical/eslint-config": "workspace:*",
    "@prismical/typescript-config": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "jsdom": "^29.1.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
