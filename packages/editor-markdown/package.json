{
  "name": "@prismical/editor-markdown",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint .",
    "type:check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prismical/editor-schema": "workspace:*",
    "@tiptap/core": "^3.23.4",
    "@tiptap/extension-emoji": "^3.23.4",
    "markdown-it": "^14.1.1",
    "prosemirror-markdown": "^1.13.4"
  },
  "devDependencies": {
    "@prismical/eslint-config": "workspace:*",
    "@prismical/typescript-config": "workspace:*",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
